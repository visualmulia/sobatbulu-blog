---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
}

const { 
	title, 
	description = "Panduan praktis perawatan hewan peliharaan, tips kesehatan kucing dan anjing, nutrisi pakan berkualitas, dan panduan merawat anabul tercinta.", 
	image,
	type = 'website'
} = Astro.props;

// Determine absolute canonical URL and image URL for metadata
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

// Default social share card image if specific featured_image is empty
const defaultOgImage = '/images/uploads/teen_petting_cat_with_ingredients_20260927231535-1-.jpg';
const resolvedImage = image && image.trim() !== '' ? image : defaultOgImage;
const ogImage = resolvedImage.startsWith('http') 
	? resolvedImage 
	: new URL(resolvedImage, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="SobatBulu" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Google AdSense Verification & Auto Ads -->
		<meta name="google-adsense-account" content="ca-pub-6193006802253158" />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6193006802253158" crossorigin="anonymous"></script>
	</head>
	<body>
		<!-- Header Navbar -->
		<header class="header">
			<div class="container header-container">
				<a href="/" class="logo">
					Sobat<span>Bulu</span>.
				</a>
				<nav class="nav">
					<a href="/" class="nav-link">Home</a>
					<a href="/sitemap" class="nav-link">Daftar Isi</a>
					<a href="/about" class="nav-link">Tentang</a>
					<a href="/search" class="nav-link search-nav-btn" title="Cari Artikel">
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
						<span>Cari</span>
					</a>
				</nav>
			</div>
		</header>

		<!-- Main Content Slot -->
		<main>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="footer">
			<div class="container footer-container">
				<div class="footer-brand">
					<a href="/" class="logo">Sobat<span>Bulu</span>.</a>
					<p class="footer-desc">Panduan praktis perawatan hewan peliharaan, tips kesehatan kucing dan anjing, ulasan pakan bernutrisi, dan panduan merawat anabul tercinta.</p>
				</div>
				<div class="footer-divider"></div>
				<div class="footer-bottom">
					<p>&copy; {new Date().getFullYear()} SobatBulu. All rights reserved.</p>
					<div class="footer-links">
						<a href="/sitemap" class="footer-link">Sitemap & Kategori</a>
						<a href="/about" class="footer-link">Tentang Kami</a>
						<a href="/privacy" class="footer-link">Privacy Policy</a>
						<a href="/terms" class="footer-link">Terms of Service</a>
						<a href="/contact" class="footer-link">Kontak</a>
						<a href="/disclaimer" class="footer-link">Disclaimer</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	.header {
		background-color: rgba(255, 253, 249, 0.85);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border-color);
		position: sticky;
		top: 0;
		z-index: 100;
		padding: 1.25rem 0;
		transition: var(--transition);
	}

	.header-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.5px;
	}

	.logo span {
		color: var(--accent);
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav-link {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-secondary);
	}

	.nav-link:hover {
		color: var(--text-primary);
	}

	.search-nav-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.03);
		border: 1px solid var(--border-color);
		transition: var(--transition);
	}

	.search-nav-btn:hover {
		background: var(--card-bg);
		border-color: var(--accent);
		color: var(--accent);
		box-shadow: var(--shadow-sm);
	}

	.footer-links {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.footer-link {
		color: var(--text-secondary);
		transition: var(--transition);
	}

	.footer-link:hover {
		color: var(--text-primary);
		text-decoration: underline;
	}

	/* Footer Styles */
	.footer {
		background-color: #FFFFFF;
		border-top: 1px solid var(--border-color);
		padding: 4rem 0 2rem 0;
		margin-top: 5rem;
	}

	.footer-container {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.footer-brand {
		max-width: 500px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.footer-desc {
		color: var(--text-secondary);
		font-size: 0.95rem;
	}

	.footer-divider {
		height: 1px;
		background-color: var(--border-color);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		color: var(--text-secondary);
		font-size: 0.85rem;
	}

	@media (max-width: 600px) {
		.header-container {
			flex-direction: column;
			gap: 1rem;
		}
		.nav {
			gap: 1.5rem;
		}
	}
</style>