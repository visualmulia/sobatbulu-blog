---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Generate paths for all blog posts
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post, allPosts: posts },
	}));
}

const { post, allPosts = [] } = Astro.props;
const { Content } = await post.render();

// Calculate related articles (max 3 posts excluding current post)
const availablePosts = allPosts.length > 0 ? allPosts : await getCollection('blog');
const relatedByTag = availablePosts
	.filter((p) => p.slug !== post.slug)
	.filter((p) => {
		const currentTags = post.data.tags || [];
		const postTags = p.data.tags || [];
		return currentTags.some((t: string) => postTags.includes(t));
	});

const fallbackPosts = availablePosts
	.filter((p) => p.slug !== post.slug && !relatedByTag.some((r) => r.slug === p.slug))
	.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const relatedPosts = [...relatedByTag, ...fallbackPosts].slice(0, 3);

// JSON-LD Article Schema
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.featured_image 
    ? (post.data.featured_image.startsWith('http') ? post.data.featured_image : new URL(post.data.featured_image, Astro.url.origin).href)
    : new URL('/favicon.svg', Astro.url.origin).href,
  "datePublished": new Date(post.data.date).toISOString(),
  "dateModified": new Date(post.data.date).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "SobatBulu",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/favicon.svg', Astro.url.origin).href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};

// Format date helper
const formatDate = (dateStr: string | Date) => {
	const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
	return new Date(dateStr).toLocaleDateString('id-ID', options);
};
---

<Layout title={`${post.data.title} - SobatBulu`} description={post.data.description} image={post.data.featured_image} type="article">
	<!-- JSON-LD Article Schema -->
	<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

	<article class="post">
		<header class="post-header">
			<div class="container post-header-container">
				<a href="/" class="back-link">← Kembali ke Home</a>
				<div class="post-meta">
					<span>{formatDate(post.data.date)}</span>
					<span>•</span>
					<span>Ditulis oleh {post.data.author}</span>
				</div>
				<h1 class="post-title">{post.data.title}</h1>
				<div class="post-tags">
					{post.data.tags.map((tag) => (
						<span class="tag">#{tag}</span>
					))}
				</div>
			</div>
		</header>

		{post.data.featured_image && (
			<div class="container post-image-container">
				<img src={post.data.featured_image} alt={post.data.title} class="post-featured-image" />
			</div>
		)}

		<div class="container post-body-container">
			<div class="post-content">
				<Content />
			</div>

			<!-- Box Profil Penulis (E-E-A-T AdSense Compliance) -->
			<div class="author-box">
				<div class="author-avatar">
					<span>SB</span>
				</div>
				<div class="author-info">
					<div class="author-badge">Dewan Redaksi SobatBulu</div>
					<h3 class="author-name">Tim Redaksi SobatBulu</h3>
					<p class="author-bio">
						Pencinta hewan peliharaan, praktisi nutrisi anabul rumahan, dan pegiat kesejahteraan hewan. Berdedikasi menyajikan panduan perawatan harian yang aman, penuh kasih sayang, dan berbasis kebiasaan satwa.
					</p>
					<a href="/about" class="author-link">Pelajari Visi & Standar Editorial Kami &rarr;</a>
				</div>
			</div>
			
			<div class="post-share">
				<span class="share-title">Bagikan artikel ini:</span>
				<div class="share-buttons">
					<a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title)}%20${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn whatsapp" title="Bagikan ke WhatsApp">
						WhatsApp
					</a>
					<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn facebook" title="Bagikan ke Facebook">
						Facebook
					</a>
					<a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="share-btn twitter" title="Bagikan ke Twitter / X">
						Twitter
					</a>
					<a href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(post.data.title)}`} target="_blank" rel="noopener noreferrer" class="share-btn telegram" title="Bagikan ke Telegram">
						Telegram
					</a>
				</div>
			</div>

			{relatedPosts.length > 0 && (
				<section class="related-section">
					<h2 class="related-title">Rekomendasi Panduan & Artikel Terkait</h2>
					<div class="related-grid">
						{relatedPosts.map((r) => (
							<a href={`/blog/${r.slug}`} class="related-card">
								{r.data.featured_image && (
									<div class="related-img-box">
										<img src={r.data.featured_image} alt={r.data.title} loading="lazy" />
									</div>
								)}
								<div class="related-body">
									<span class="related-date">{formatDate(r.data.date)}</span>
									<h4 class="related-heading">{r.data.title}</h4>
									<p class="related-desc">{r.data.description.slice(0, 95)}...</p>
									<span class="related-read-more">Baca Panduan &rarr;</span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}
		</div>
	</article>
</Layout>

<style>
	.post {
		padding: 4rem 0;
	}

	.post-header {
		text-align: center;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 3rem;
	}

	.post-header-container {
		max-width: 800px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.back-link {
		font-size: 0.9rem;
		color: var(--accent);
		font-weight: 600;
		align-self: flex-start;
	}

	.back-link:hover {
		color: var(--accent-hover);
	}

	.post-meta {
		display: flex;
		gap: 0.5rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
		font-weight: 500;
	}

	.post-title {
		font-size: 2.75rem;
		line-height: 1.25;
		letter-spacing: -0.5px;
		font-weight: 800;
	}

	.post-tags {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent-hover);
		background-color: var(--accent-light);
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
	}

	.post-image-container {
		max-width: 800px;
		margin: 0 auto 3rem auto;
	}

	.post-featured-image {
		width: 100%;
		max-height: 480px;
		object-fit: cover;
		border-radius: 16px;
		border: 1px solid var(--border-color);
		box-shadow: var(--shadow-md);
	}

	.post-body-container {
		max-width: 800px;
	}

	/* Typography & Markdown styling */
	.post-content {
		font-family: var(--font-sans);
		font-size: 1.12rem;
		color: var(--text-primary);
		line-height: 1.85;
	}

	/* Contextual Internal Links styling for High Click-Through & Readability */
	.post-content :global(a) {
		color: var(--accent);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
		transition: var(--transition);
	}

	.post-content :global(a:hover) {
		color: var(--accent-coral);
		text-decoration-color: var(--accent-coral);
	}

	.post-content :global(h2) {
		font-size: 1.75rem;
		font-weight: 700;
		margin: 2.5rem 0 1rem 0;
		letter-spacing: -0.5px;
	}

	.post-content :global(h3) {
		font-size: 1.35rem;
		font-weight: 700;
		margin: 2rem 0 1rem 0;
	}

	.post-content :global(p) {
		margin-bottom: 1.5rem;
	}

	.post-content :global(ul), .post-content :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 2rem;
	}

	.post-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.post-content :global(blockquote) {
		border-left: 4px solid var(--accent);
		padding-left: 1.5rem;
		margin: 2rem 0;
		font-style: italic;
		color: var(--text-secondary);
		background-color: var(--accent-light);
		padding: 1rem 1.5rem;
		border-radius: 0 8px 8px 0;
	}

	.post-content :global(pre) {
		background-color: #F8F5F0;
		border: 1px solid var(--border-color);
		padding: 1.5rem;
		border-radius: 12px;
		overflow-x: auto;
		margin: 2rem 0;
	}

	.post-content :global(code) {
		font-family: monospace;
		font-size: 0.95rem;
		background-color: var(--accent-light);
		color: var(--accent-hover);
		padding: 0.15rem 0.35rem;
		border-radius: 4px;
	}

	.post-content :global(pre code) {
		background-color: transparent;
		color: inherit;
		padding: 0;
	}

	.post-content :global(hr) {
		border: none;
		height: 1px;
		background-color: var(--border-color);
		margin: 3rem 0;
	}

	.post-content :global(table) {
		display: block;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		border-collapse: collapse;
		margin: 2.5rem 0;
		border: 1px solid var(--border-color);
		border-radius: 12px;
		background-color: var(--card-bg);
	}

	.post-content :global(th),
	.post-content :global(td) {
		padding: 0.75rem 1rem;
		text-align: left;
		border-bottom: 1px solid var(--border-color);
		font-size: 0.95rem;
	}

	.post-content :global(th) {
		background-color: var(--accent-light);
		color: var(--text-primary);
		font-family: var(--font-display);
		font-weight: 700;
		border-bottom: 2px solid var(--border-color);
		min-width: 120px;
	}

	.post-content :global(tr:last-child td) {
		border-bottom: none;
	}

	.post-content :global(tr:nth-child(even)) {
		background-color: rgba(0, 0, 0, 0.015);
	}

	/* Author Bio Box */
	.author-box {
		margin-top: 3.5rem;
		padding: 2rem;
		background-color: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 16px;
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
		box-shadow: var(--shadow-sm);
	}

	.author-avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--accent), var(--accent-coral));
		color: #FFFFFF;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 800;
		flex-shrink: 0;
		box-shadow: var(--shadow-sm);
	}

	.author-info {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.author-badge {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.8px;
		color: var(--accent-hover);
	}

	.author-name {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0;
	}

	.author-bio {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.author-link {
		margin-top: 0.5rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		align-self: flex-start;
		transition: var(--transition);
	}

	.author-link:hover {
		color: var(--accent-coral);
		text-decoration: underline;
	}

	/* Share buttons */
	.post-share {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.share-title {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--text-secondary);
	}

	.share-buttons {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.share-btn {
		font-size: 0.9rem;
		font-weight: 600;
		padding: 0.5rem 1rem;
		border-radius: 8px;
		color: #FFFFFF;
		transition: var(--transition);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
	}

	.share-btn.whatsapp { background-color: #25D366; }
	.share-btn.whatsapp:hover { background-color: #128C7E; }

	.share-btn.facebook { background-color: #1877F2; }
	.share-btn.facebook:hover { background-color: #166FE5; }

	.share-btn.twitter { background-color: #1DA1F2; }
	.share-btn.twitter:hover { background-color: #1A91DA; }

	.share-btn.telegram { background-color: #0088CC; }
	.share-btn.telegram:hover { background-color: #0077B5; }

	/* Related Articles Section */
	.related-section {
		margin-top: 4rem;
		padding-top: 3rem;
		border-top: 1px solid var(--border-color);
	}

	.related-title {
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.75rem;
		letter-spacing: -0.5px;
	}

	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.related-card {
		background-color: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.related-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
		border-color: var(--accent);
	}

	.related-img-box {
		width: 100%;
		height: 150px;
		overflow: hidden;
		background-color: var(--accent-light);
	}

	.related-img-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.related-card:hover .related-img-box img {
		transform: scale(1.05);
	}

	.related-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.related-date {
		font-size: 0.78rem;
		color: var(--text-secondary);
		margin-bottom: 0.4rem;
	}

	.related-heading {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1.35;
		margin-bottom: 0.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.related-desc {
		font-size: 0.85rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin-bottom: 1rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.related-read-more {
		margin-top: auto;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		transition: var(--transition);
	}

	.related-card:hover .related-read-more {
		color: var(--accent-coral);
	}

	@media (max-width: 768px) {
		.post-title {
			font-size: 2.1rem;
		}
		.post-content {
			font-size: 1.05rem;
		}
		.author-box {
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 1.5rem;
		}
		.author-link {
			align-self: center;
		}
		.related-grid {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
	}
</style>