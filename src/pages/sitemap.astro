---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Fetch all blog posts
const posts = await getCollection('blog');

// Define category taxonomies and match posts
const categories = [
	{
		id: 'kucing-kesehatan',
		title: 'Kesehatan, Nutrisi & Perawatan Kucing',
		icon: '🐱',
		description: 'Panduan lengkap merawat anak kucing baru lahir, anak kucing tanpa induk, pembasmian kutu alami, gejala cacingan, serta rekomendasi makanan dan vitamin penambah nafsu makan.',
		slugs: [
			'cara-merawat-anak-kucing-baru-lahir',
			'cara-merawat-anak-kucing-kittens-tanpa-induk-agar-sehat',
			'cara-mengatasi-kutu-kucing-membandel-dengan-bahan-alami',
			'gejala-dan-ciri-kucing-sedang-sakit-cacingan-parah',
			'rekomendasi-makanan-kucing-murah-berkualitas-tinggi',
			'rekomendasi-vitamin-kucing-terbaik-agar-gemuk-rimbun',
		]
	},
	{
		id: 'perilaku-kucing',
		title: 'Perilaku & Pelatihan Anabul',
		icon: '🐾',
		description: 'Tips memahami psikologi dan kebiasaan kucing rumahan, termasuk teknik melatih anabul agar tidak merusak dan mencakar perabotan atau sofa rumah.',
		slugs: [
			'tips-melatih-kucing-agar-tidak-mencakar-sofa-furniture',
		]
	},
	{
		id: 'anjing-keluarga',
		title: 'Panduan Anjing Peliharaan & Keluarga',
		icon: '🐶',
		description: 'Rekomendasi ras anjing yang ramah anak dan keluarga, serta panduan potty training agar anjing terbiasa buang air secara teratur dan disiplin.',
		slugs: [
			'panduan-memilih-jenis-anjing-peliharaan-ramah-keluarga',
			'panduan-melatih-anjing-peliharaan-agar-buang-air-teratur',
		]
	},
	{
		id: 'satwa-kecil-ikan',
		title: 'Satwa Kecil, Burung & Ikan Hias',
		icon: '🐰',
		description: 'Cara merawat kelinci agar tidak gampang stres, panduan memelihara hamster untuk pemula/anak-anak, sanitasi kandang burung berkicau, dan jenis ikan hias air tawar yang mudah dirawat.',
		slugs: [
			'cara-merawat-kelinci-peliharaan-agar-tidak-mudah-stres',
			'cara-merawat-hamster-peliharaan-untuk-anak-anak',
			'cara-merawat-kebersihan-kandang-burung-peliharaan',
			'rekomendasi-jenis-ikan-hias-air-tawar-mudah-dipelihara',
		]
	}
];

// Helper to get post by slug
const getPostBySlug = (slug: string) => posts.find((p) => p.slug === slug);

// Format date helper
const formatDate = (dateStr: string | Date) => {
	const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
	return new Date(dateStr).toLocaleDateString('id-ID', options);
};
---

<Layout 
	title="Sitemap & Indeks Kategori Perawatan Hewan - SobatBulu" 
	description="Peta situs dan direktori kategori panduan SobatBulu. Temukan seluruh artikel perawatan kucing, anjing, kelinci, hamster, burung, dan ikan hias terlengkap.">
	
	<!-- Hero Section -->
	<section class="sitemap-hero">
		<div class="container hero-inner">
			<span class="badge">DIREKTORI & PETA SITUS</span>
			<h1>Sitemap & Indeks Kategori</h1>
			<p class="lead">
				Jelajahi seluruh panduan perawatan anabul, tips kesehatan satwa peliharaan, rekomendasi nutrisi terbaik, dan panduan melatih kebiasaan hewan kesayangan Anda.
			</p>
			<div class="hero-stats">
				<div class="stat-item">
					<span class="stat-number">{posts.length}</span>
					<span class="stat-label">Panduan Satwa</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">{categories.length}</span>
					<span class="stat-label">Klaster Kategori</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">100%</span>
					<span class="stat-label">Akses Gratis</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Main Categories Section -->
	<section class="sitemap-content">
		<div class="container content-container">

			<!-- Category Quick Jump Navigation -->
			<div class="quick-nav">
				<span class="quick-nav-title">Lompat ke Topik:</span>
				<div class="quick-nav-links">
					{categories.map((cat) => (
						<a href={`#${cat.id}`} class="quick-nav-pill">
							<span class="pill-icon">{cat.icon}</span>
							<span>{cat.title}</span>
						</a>
					))}
					<a href="#halaman-utama" class="quick-nav-pill">
						<span class="pill-icon">📄</span>
						<span>Halaman Utama</span>
					</a>
				</div>
			</div>

			<!-- Categories Group -->
			<div class="categories-list">
				{categories.map((cat) => {
					const categoryPosts = cat.slugs
						.map((s) => getPostBySlug(s))
						.filter(Boolean);

					return (
						<div id={cat.id} class="category-block">
							<div class="category-header">
								<div class="category-title-wrap">
									<span class="category-icon">{cat.icon}</span>
									<div>
										<h2 class="category-title">{cat.title}</h2>
										<p class="category-desc">{cat.description}</p>
									</div>
								</div>
								<span class="category-count">{categoryPosts.length} Panduan</span>
							</div>

							<div class="articles-grid">
								{categoryPosts.map((post) => post && (
									<article class="article-item">
										<a href={`/blog/${post.slug}`} class="article-link">
											<div class="article-info">
												<div class="article-meta">
													<span class="article-date">{formatDate(post.data.date)}</span>
													<span class="article-author">• {post.data.author}</span>
												</div>
												<h3 class="article-title">{post.data.title}</h3>
												<p class="article-snippet">
													{post.data.description || (post.body ? post.body.slice(0, 110) + '...' : '')}
												</p>
												<span class="read-more">Baca Panduan &rarr;</span>
											</div>
										</a>
									</article>
								))}
							</div>
						</div>
					);
				})}
			</div>

			<!-- Static & Legal Pages Directory -->
			<div id="halaman-utama" class="category-block static-pages-block">
				<div class="category-header">
					<div class="category-title-wrap">
						<span class="category-icon">📄</span>
						<div>
							<h2 class="category-title">Halaman Informasi & Legalitas</h2>
							<p class="category-desc">Struktur navigasi halaman utama, transparansi editorial, dan kebijakan privasi SobatBulu.</p>
						</div>
					</div>
					<span class="category-count">5 Halaman</span>
				</div>

				<div class="static-pages-grid">
					<a href="/" class="static-page-card">
						<div class="static-icon">🏠</div>
						<div class="static-content">
							<span class="static-title">Beranda Utama (Home)</span>
							<p class="static-desc">Halaman depan kurasi panduan perawatan hewan peliharaan terbaru.</p>
						</div>
					</a>
					<a href="/about" class="static-page-card">
						<div class="static-icon">💡</div>
						<div class="static-content">
							<span class="static-title">Tentang SobatBulu</span>
							<p class="static-desc">Misi redaksi dalam menghadirkan informasi perawatan satwa yang penuh kasih dan terpercaya.</p>
						</div>
					</a>
					<a href="/search" class="static-page-card">
						<div class="static-icon">🔍</div>
						<div class="static-content">
							<span class="static-title">Pencarian Artikel</span>
							<p class="static-desc">Cari tips kesehatan kucing, pakan anabul, dan panduan satwa lainnya.</p>
						</div>
					</a>
					<a href="/privacy" class="static-page-card">
						<div class="static-icon">🔒</div>
						<div class="static-content">
							<span class="static-title">Kebijakan Privasi</span>
							<p class="static-desc">Standar perlindungan data pribadi pengunjung dan transparansi analitik.</p>
						</div>
					</a>
					<a href="/terms" class="static-page-card">
						<div class="static-icon">⚖️</div>
						<div class="static-content">
							<span class="static-title">Syarat & Ketentuan</span>
							<p class="static-desc">Pedoman hak cipta konten, penggunaan informasi, dan disclaimer editorial.</p>
						</div>
					</a>
				</div>
			</div>

		</div>
	</section>
</Layout>

<style>
	/* Hero Section */
	.sitemap-hero {
		background-color: var(--card-bg);
		border-bottom: 1px solid var(--border-color);
		padding: 4.5rem 0 3.5rem 0;
		text-align: center;
	}

	.hero-inner {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}

	.badge {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--accent-hover);
		background-color: var(--accent-light);
		padding: 0.35rem 0.9rem;
		border-radius: 999px;
	}

	.hero-inner h1 {
		font-size: 2.75rem;
		font-weight: 800;
		letter-spacing: -0.5px;
		color: var(--text-primary);
		line-height: 1.2;
		margin: 0;
	}

	.lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin: 0;
	}

	.hero-stats {
		display: flex;
		justify-content: center;
		gap: 3rem;
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-color);
		width: 100%;
		max-width: 500px;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.stat-number {
		font-family: var(--font-display);
		font-size: 2.1rem;
		font-weight: 800;
		color: var(--accent);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.82rem;
		color: var(--text-secondary);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	/* Sitemap Content */
	.sitemap-content {
		padding: 3.5rem 0 5rem 0;
	}

	.content-container {
		max-width: 1000px;
		margin: 0 auto;
	}

	/* Quick Navigation Pills */
	.quick-nav {
		background-color: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 16px;
		padding: 1.25rem 1.5rem;
		margin-bottom: 3.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		box-shadow: var(--shadow-sm);
	}

	.quick-nav-title {
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.8px;
		color: var(--text-secondary);
	}

	.quick-nav-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.quick-nav-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background-color: var(--accent-light);
		color: var(--text-primary);
		font-size: 0.88rem;
		font-weight: 600;
		padding: 0.45rem 0.9rem;
		border-radius: 9999px;
		text-decoration: none;
		border: 1px solid transparent;
		transition: var(--transition);
	}

	.quick-nav-pill:hover {
		background-color: var(--card-bg);
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
	}

	.pill-icon {
		font-size: 1.05rem;
	}

	/* Category Block */
	.categories-list {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.category-block {
		scroll-margin-top: 5rem;
	}

	.category-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding-bottom: 1.25rem;
		border-bottom: 2px solid var(--border-color);
		margin-bottom: 1.5rem;
		gap: 1rem;
	}

	.category-title-wrap {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	.category-icon {
		font-size: 2.2rem;
		line-height: 1;
		padding: 0.4rem;
		background-color: var(--card-bg);
		border-radius: 12px;
		border: 1px solid var(--border-color);
		box-shadow: var(--shadow-sm);
		flex-shrink: 0;
	}

	.category-title {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0 0 0.35rem 0;
		letter-spacing: -0.5px;
	}

	.category-desc {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin: 0;
	}

	.category-count {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent-hover);
		background-color: var(--accent-light);
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		white-space: nowrap;
		flex-shrink: 0;
	}

	/* Articles Grid */
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.article-item {
		background-color: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 14px;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: var(--transition);
	}

	.article-item:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: var(--accent);
	}

	.article-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.35rem;
		text-decoration: none;
		color: inherit;
	}

	.article-info {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.article-meta {
		font-size: 0.8rem;
		color: var(--text-secondary);
		margin-bottom: 0.6rem;
		font-weight: 500;
	}

	.article-title {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--text-primary);
		margin: 0 0 0.6rem 0;
		transition: color 0.15s ease;
	}

	.article-item:hover .article-title {
		color: var(--accent);
	}

	.article-snippet {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0 0 1.2rem 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more {
		margin-top: auto;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
		transition: var(--transition);
	}

	.article-item:hover .read-more {
		color: var(--accent-coral);
	}

	/* Static & Legal Pages */
	.static-pages-block {
		margin-top: 4.5rem;
		padding-top: 2rem;
	}

	.static-pages-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.static-page-card {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		background-color: var(--card-bg);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: 1.25rem;
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-sm);
		transition: var(--transition);
	}

	.static-page-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}

	.static-icon {
		font-size: 1.5rem;
		line-height: 1;
		flex-shrink: 0;
		padding: 0.4rem;
		background-color: var(--accent-light);
		border-radius: 10px;
	}

	.static-content {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.static-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.static-page-card:hover .static-title {
		color: var(--accent);
	}

	.static-desc {
		font-size: 0.85rem;
		color: var(--text-secondary);
		line-height: 1.5;
		margin: 0;
	}

	@media (max-width: 768px) {
		.hero-inner h1 {
			font-size: 2.1rem;
		}
		.hero-stats {
			gap: 1.5rem;
		}
		.articles-grid,
		.static-pages-grid {
			grid-template-columns: 1fr;
		}
		.category-header {
			flex-direction: column;
			align-items: flex-start;
		}
		.category-count {
			align-self: flex-start;
		}
	}
</style>